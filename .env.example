# Copy to .env (repo root) and to apps/api/.env for local development.
# Never commit real secrets.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4100
# Number of reverse proxies in front of the API (for correct client IPs). 0 in local dev.
TRUST_PROXY=0
LOG_LEVEL=log

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://birthday:birthday@localhost:5437/birthday
# Used by the API test suite only; must end in _test.
TEST_DATABASE_URL=postgresql://birthday:birthday@localhost:5437/birthday_test

# --- Auth --------------------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# true in production (requires HTTPS)
COOKIE_SECURE=false
# Optional, e.g. .example.com when the API and site are on sibling subdomains
COOKIE_DOMAIN=
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- URLs --------------------------------------------------------------------
# Where the public site is served. Used in emails, QR codes, canonical URLs and the sitemap.
PUBLIC_WEB_URL=http://localhost:5173
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# --- Object storage: Azure Blob Storage -------------------------------------
# Local development uses Azurite (the official emulator, started by docker compose).
# The long key below is Azurite's public, well-known development key, not a secret.
# Production: Azure portal > Storage account > Access keys > Connection string.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10100/devstoreaccount1;"
# Private container for photos and videos (created automatically if missing).
AZURE_STORAGE_CONTAINER=birthday-media

# --- Upload defaults (seed values; admins change them in Settings) ------------
# 10 GB
MAX_STORAGE_BYTES=10737418240
# 10 MB
MAX_PHOTO_SIZE=10485760
# 100 MB
MAX_VIDEO_SIZE=104857600
# Guest uploads allowed per IP address per hour
GUEST_UPLOAD_FILES_PER_HOUR=60

# --- Email -------------------------------------------------------------------
# Leave SMTP_HOST empty to log emails to the console instead of sending them.
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Celebration Team <no-reply@example.com>"
# Where admin notifications (new testimonials, uploads) go. Empty = none.
ADMIN_NOTIFY_EMAIL=

# --- Seed ----------------------------------------------------------------------
# First super admin created by `npm run db:seed` when no users exist (production).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# true = also load demo content (celebrant, guests, photos...)
SEED_DEMO=true

# --- Web server (apps/web/server/index.mjs, production only) ------------------
# Folder where the web server saves the last good copy of the public site data.
# Guests see it when the API is down. Keep it on a volume to survive redeploys.
# Default: the system temp folder, e.g. /tmp/birthday-web-snapshot
# SNAPSHOT_DIR=/var/lib/birthday-web
