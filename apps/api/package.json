{
  "name": "@birthday/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API for the birthday celebration platform",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:migrate-seed": "prisma migrate deploy && node dist/seed/run-seed.js && node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "nest build && node dist/seed/run-seed.js",
    "db:seed:fresh": "nest build && node dist/seed/run-seed.js --fresh",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "test": "jest && jest -c jest.e2e.config.js --runInBand",
    "test:unit": "jest",
    "test:e2e": "jest -c jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "@azure/storage-blob": "12.34.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "nodemailer": "10.0.10",
    "pdfkit": "0.20.2",
    "pg": "^8.16.0",
    "prisma": "7.10.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@birthday/types": "*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "jest": "30.5.2",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
